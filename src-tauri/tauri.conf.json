{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZWeather",
  "version": "0.1.0",
  "identifier": "com.zweather.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZWeather",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "center": true,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "tray",
        "title": "ZWeather",
        "width": 360,
        "height": 440,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "ZWeather"
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 TheHolyOneZ. Licensed under GPL-3.0.",
    "category": "Utility",
    "shortDescription": "Native desktop weather dashboard. No account, no telemetry.",
    "longDescription": "ZWeather is a polished native desktop weather dashboard with tray icon, animated radar, multiple locations, and severe-weather alerts. Built on Tauri + Rust + React 19."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
